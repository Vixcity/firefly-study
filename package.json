{
  "name": "firefly-study",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "萤火书房 —— 阅读习惯养成 App（移动端 PWA / 可打包成安卓 APK）",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:native": "vite build --mode capacitor",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/smoke-test.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "android:sync": "npm run build:native && cap sync android",
    "android:apk": "npm run android:sync && node scripts/build-apk.mjs",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "antd-mobile": "^5.43.0",
    "dayjs": "^1.11.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
